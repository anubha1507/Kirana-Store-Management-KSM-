{
  "name": "ksm-kirana-store-management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Kirana Store Management Software - React + TypeScript frontend for the KSM REST API in backend/",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "validate:db": "node scripts/validate-db.mjs",
    "validate:ui": "node scripts/validate-ui.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
