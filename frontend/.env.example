# Frontend environment variables (Vite)
# Copy this file to `.env` (or `.env.local`) and fill in the values.

# Base URL of the KSM REST API (backend/). Use `/api` when the backend is
# deployed in the same Vercel project, or a full HTTPS URL for an external API.
# When this is unset the app runs
# in local demo mode with the in-memory DemoEngine — no server required.
VITE_API_BASE_URL=/api

VITE_APP_NAME=Kirana Store Management

# Backend environment variables (PORT, DATABASE_URL, JWT_SECRET, FRONTEND_URL)
# live in backend/.env.example — copy that file to backend/.env instead.
# Never commit real secrets: backend/.env and frontend/.env are gitignored.
