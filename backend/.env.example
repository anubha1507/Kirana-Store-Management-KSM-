# PostgreSQL connection used by the REST API.
# Local:      postgresql://postgres:postgres@localhost:5432/kirana_store
# Supabase:   the project's direct connection string (Settings → Database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kirana_store
# REQUIRED — the API refuses to boot without a JWT signing secret.
# Generate one: openssl rand -hex 48   (never commit the real value)
JWT_SECRET=replace-with-long-random-secret
JWT_ISSUER=http://localhost:5000/api
JWT_AUDIENCE=kirana-store-admin
# Frontend dev server origin(s) allowed by CORS, comma-separated.
FRONTEND_URL=http://localhost:5173
PORT=5000
NODE_ENV=development
