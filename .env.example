# ---------------------------------------------------------------------------
# Kirana Store Management - frontend environment
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the two values from
# Supabase Dashboard -> Project Settings -> API.
#
# When these are absent the app runs in LOCAL DEMO MODE: an in-browser engine
# that mirrors the PostgreSQL contract in supabase/migrations (invoice
# counters, stock ledger, udhaar ledger, payment ceiling, idempotency and the
# owner/manager/cashier role ladder). That is what makes `npm run dev` show the
# complete product on http://localhost:5173 with zero setup.
#
# NEVER put the service_role key here: anything in VITE_* ships to the browser.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: label shown in the top bar and on the sign-in screen.
VITE_APP_NAME=Kirana Store Management